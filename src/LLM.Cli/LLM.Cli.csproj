<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LLM.Core\LLM.Core.csproj">
      <!-- ProjectReference strips RuntimeIdentifier for framework-dependent
           inner builds. Forward the Linux source choice explicitly so a
           Windows-hosted linux-x64 publish does not compile D3D12 shaders. -->
      <AdditionalProperties Condition="'$(RuntimeIdentifier)' != '' and !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">EnableD3D12Backend=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Parquet.Net" Version="6.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The GPU backend needs a runtime where [UnsafeAccessor] ref-readonly works (.NET 9.0.2 has a JIT bug, fixed in .NET 10); roll to the newest installed runtime when available -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

</Project>
